<?xml version="1.0" encoding="utf-8"?>
<!--
  BB_Toolkit - autounattend.xml
  Windows 11 Pro 26H2 x64, English UI, US + Slovak (QWERTY) keyboard, Prague time zone,
  local account "BB", no Microsoft account.
  Region is set up as Czech Republic (EEA); firstlogon.ps1 then switches the formats
  to English (World).

  Hands-off except ONE stop: setup asks where to install. Nothing on the disk is touched
  automatically - you delete the old Windows partition yourself and pick the space.
  See README.md -> "Install".

  Usage: copy the whole repository (this file must end up in the USB root as
  \autounattend.xml, the rest of the repo next to it) onto the Windows install USB.
-->
<unattend xmlns="urn:schemas-microsoft-com:unattend" xmlns:wcm="http://schemas.microsoft.com/WMIConfig/2002/State">

  <!-- ===================== windowsPE: installer ===================== -->
  <settings pass="windowsPE">
    <component name="Microsoft-Windows-International-Core-WinPE" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <SetupUILanguage>
        <UILanguage>en-US</UILanguage>
      </SetupUILanguage>
      <InputLocale>0409:00000409;041b:0001041b</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <UserLocale>en-US</UserLocale>
    </component>

    <component name="Microsoft-Windows-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <!-- No DiskConfiguration / ImageInstall on purpose: setup stops at the disk page and
           you choose where Windows goes, so nothing is ever wiped by a hard-coded disk
           or partition number. -->
      <UserData>
        <!-- Microsoft's public generic setup key for Windows 11 Pro. It only selects the
             edition; the real license is read from the HP firmware and activates on its own. -->
        <ProductKey>
          <Key>VK7JG-NPHTM-C97JM-9MPGT-3V66T</Key>
          <WillShowUI>Never</WillShowUI>
        </ProductKey>
        <AcceptEula>true</AcceptEula>
      </UserData>

      <RunSynchronous>
        <!-- Skip TPM/Secure Boot/RAM checks (harmless on supported HW, saves surprises) -->
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg.exe add "HKLM\SYSTEM\Setup\LabConfig" /v BypassTPMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg.exe add "HKLM\SYSTEM\Setup\LabConfig" /v BypassSecureBootCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>reg.exe add "HKLM\SYSTEM\Setup\LabConfig" /v BypassRAMCheck /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

  <!-- ===================== specialize ===================== -->
  <settings pass="specialize">
    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <ComputerName>BB-ZBOOK</ComputerName>
      <TimeZone>Central Europe Standard Time</TimeZone>
    </component>

    <component name="Microsoft-Windows-Deployment" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <RunSynchronous>
        <!-- Fallback only: setup stays offline (no Wi-Fi page) and creates the local account
             below, so no Microsoft account screen. Harmless if a future build ignores it. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Path>reg.exe add "HKLM\SOFTWARE\Microsoft\Windows\CurrentVersion\OOBE" /v BypassNRO /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <!-- Do not auto-encrypt the drive during setup; turn BitLocker on yourself afterwards -->
        <RunSynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Path>reg.exe add "HKLM\SYSTEM\CurrentControlSet\Control\BitLocker" /v PreventDeviceEncryption /t REG_DWORD /d 1 /f</Path>
        </RunSynchronousCommand>
        <!-- Local passwords never expire (default is 42 days) -->
        <RunSynchronousCommand wcm:action="add">
          <Order>3</Order>
          <Path>net.exe accounts /maxpwage:UNLIMITED</Path>
        </RunSynchronousCommand>
        <!-- Remove the junk apps from the image before the BB profile exists, so they are
             never installed (debloat.ps1 -SystemOnly from this repo on the USB - the drive
             with sources\boot.wim, so a stray copy on another drive is never picked up).
             Kept terse on purpose: Path is limited to 259 characters. -->
        <RunSynchronousCommand wcm:action="add">
          <Order>4</Order>
          <Path>powershell.exe -NoP -EP Bypass -C "$r=(Get-PSDrive -PSProvider FileSystem).Root|?{Test-Path($_+'sources\boot.wim')}|select -f 1;$s=$r+'install\debloat.ps1';$l='C:\Windows\Temp\bb-debloat-system.log';if($r){&amp;$s -SystemOnly *&gt;$l}else{'USB not found'&gt;$l}"</Path>
        </RunSynchronousCommand>
      </RunSynchronous>
    </component>
  </settings>

  <!-- ===================== oobeSystem: first boot ===================== -->
  <settings pass="oobeSystem">
    <component name="Microsoft-Windows-International-Core" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <InputLocale>0409:00000409;041b:0001041b</InputLocale>
      <SystemLocale>en-US</SystemLocale>
      <UILanguage>en-US</UILanguage>
      <!-- cs-CZ = region Czech Republic, which fixes the EEA device region at setup.
           en-001 here would make the region "World" (not EEA). -->
      <UserLocale>cs-CZ</UserLocale>
    </component>

    <component name="Microsoft-Windows-Shell-Setup" processorArchitecture="amd64" publicKeyToken="31bf3856ad364e35" language="neutral" versionScope="nonSxS">
      <OOBE>
        <HideEULAPage>true</HideEULAPage>
        <HideOEMRegistrationScreen>true</HideOEMRegistrationScreen>
        <HideOnlineAccountScreens>true</HideOnlineAccountScreens>
        <HideWirelessSetupInOOBE>true</HideWirelessSetupInOOBE>
        <ProtectYourPC>3</ProtectYourPC>
      </OOBE>

      <!-- Local admin account "BB" with an EMPTY password.
           No password is stored in this repo. Set a password/PIN right after the first login. -->
      <UserAccounts>
        <LocalAccounts>
          <LocalAccount wcm:action="add">
            <Name>BB</Name>
            <DisplayName>BB</DisplayName>
            <Group>Administrators</Group>
            <Password>
              <Value></Value>
              <PlainText>true</PlainText>
            </Password>
          </LocalAccount>
        </LocalAccounts>
      </UserAccounts>

      <!-- One auto-logon. Windows adds 1 to LogonCount (known issue), so firstlogon.ps1 and
           command 1 below reset it to 0 - Microsoft's documented workaround. -->
      <AutoLogon>
        <Enabled>true</Enabled>
        <LogonCount>1</LogonCount>
        <Username>BB</Username>
        <Password>
          <Value></Value>
          <PlainText>true</PlainText>
        </Password>
      </AutoLogon>

      <!-- These now all start at the same time (no waiting on Order), so each one must
           stand on its own; the real work is chained inside firstlogon.ps1. -->
      <FirstLogonCommands>
        <SynchronousCommand wcm:action="add">
          <Order>1</Order>
          <Description>Stop further auto-logons</Description>
          <CommandLine>reg.exe add "HKLM\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Winlogon" /v AutoLogonCount /t REG_DWORD /d 0 /f</CommandLine>
        </SynchronousCommand>
        <!-- Find the install USB (the drive with sources\boot.wim) and run install\firstlogon.ps1 from it -->
        <SynchronousCommand wcm:action="add">
          <Order>2</Order>
          <Description>BB_Toolkit first logon</Description>
          <CommandLine>powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$r = (Get-PSDrive -PSProvider FileSystem).Root | Where-Object { Test-Path ($_ + 'sources\boot.wim') } | Select-Object -First 1; $l = 'C:\Windows\Temp\bb-firstlogon.log'; if ($r) { &amp; ($r + 'install\firstlogon.ps1') *&gt; $l } else { 'install USB not found' | Out-File $l }"</CommandLine>
        </SynchronousCommand>
      </FirstLogonCommands>
    </component>
  </settings>
</unattend>
